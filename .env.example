# Muna's Haven — local configuration template
#
# Copy this file to `.env` and fill in the two values from:
#   Supabase dashboard -> Project Settings -> API
#
# Both values are PUBLIC browser configuration. The publishable (anon) key is
# designed to be visible in a public frontend; real access control is enforced
# by Row Level Security in PostgreSQL, not by secrecy of this key.
#
# NEVER put any of these in this file or anywhere in this repository:
#   - the service_role / secret key
#   - the Postgres database password
#   - SMTP credentials
#   - the owner's password
#   - a Supabase personal access token

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=sb1_pub_YOUR-PUBLISHABLE-KEY

# Optional: the URL the site is deployed at. Used when building shareable
# product links and WhatsApp messages. Leave blank to auto-detect from the
# browser at runtime (recommended for GitHub Pages).
PUBLIC_SITE_URL=
