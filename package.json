{
  "name": "munas-haven",
  "version": "1.0.0",
  "private": true,
  "description": "Muna's Haven — fashion & beauty catalogue with a secure owner dashboard. Static frontend on GitHub Pages + Supabase.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node scripts/serve.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test",
    "build:site": "node scripts/build.mjs --site",
    "check": "node scripts/check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
